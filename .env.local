# Local development override. This checkout runs against a safe placeholder so the
# app boots and the local-fixture check scripts (which stub fetch for *.supabase.co
# and seed `sb-local-placeholder-auth-token`) stay reproducible. Replace both values
# with your own project before deploying.
VITE_SUPABASE_URL=https://local-placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=local-placeholder-anon-key
