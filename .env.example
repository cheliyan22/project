# Copy this file to `.env.local` and fill in your own project values.
# The client is created at import time, so BOTH keys must be present or the app
# will not boot — it throws "supabaseUrl is required." before React renders.
#
# Get these from your Supabase project: Settings → API.
#   Project URL     → VITE_SUPABASE_URL
#   anon public key → VITE_SUPABASE_ANON_KEY   (safe in the browser; RLS protects data)
#
# DO NOT put the service_role key here — anything in VITE_* is shipped to the browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional. Where the Vault's "Support" button sends people (the vault lives at
# src/planet/modules/vault). Defaults to a mailto: link when unset, so the panel
# never points at a payment page you have not configured.
# VITE_SUPPORT_URL=https://example.com/support
