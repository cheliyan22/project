      "html": "<div class=\"relative w-full overflow-hidden bg-[#03050a] text-[#eae6dc]\" data-kid=\"1\" id=\"rb\" style=\"height:100vh;min-height:840px;--accent:#3DD8FF\">\n<div class=\"absolute inset-0\" data-kid=\"1-1\" id=\"stage\"></div>\n<div class=\"pointer-events-none absolute inset-0 z-10\" data-kid=\"1-2\" id=\"markers\"></div>\n<div class=\"pointer-events-none absolute inset-0 z-10\" data-kid=\"1-3\" style=\"background:linear-gradient(90deg,#040b12bd 0%,rgba(4,11,18,0) 38%,rgba(4,11,18,0) 70%,#040b1240 100%),linear-gradient(0deg,#040b12ee 0%,rgba(4,11,18,0) 26%,rgba(4,11,18,0) 84%,#040b1250 100%)\"></div>\n<div class=\"pointer-events-none absolute inset-0 z-40 transition-opacity duration-[520ms]\" data-kid=\"1-4\" id=\"veil\" style=\"opacity:0\"></div>\n<div class=\"absolute left-1/2 top-1/2 z-50 hidden -translate-x-1/2 -translate-y-1/2 border border-[#a56464] bg-[#1a1013] px-4 py-3 font-mono text-[11px] text-[#e6c7bd]\" data-kid=\"1-5\" id=\"err\"></div>\n<header class=\"absolute inset-x-0 top-0 z-20 flex items-center justify-between px-[62px] pt-[24px]\" data-kid=\"1-6\">\n<div class=\"flex items-center gap-[10px]\" data-kid=\"1-6-1\">\n<span class=\"h-[5px] w-[5px] rounded-full bg-[#d8bb85]\" data-kid=\"1-6-1-1\" style=\"box-shadow:0 0 12px #d8bb85aa\"></span>\n<span class=\"font-mono text-[9px] tracking-[0.22em] text-[#b7c4c4]\" data-kid=\"1-6-1-2\">REBOOT / ORBITAL ARCHIVE</span>\n</div>\n<div class=\"flex items-center gap-[14px]\" data-kid=\"1-6-2\">\n<span class=\"font-mono text-[9px] tracking-[0.16em] text-[#8da3a7]\" data-kid=\"1-6-2-1\" id=\"viewLabel\">ORBITAL VIEW</span>\n<button class=\"flex items-center gap-[7px] border border-[#5d756d66] bg-[#071018cc] px-[10px] py-[6px] font-mono text-[9px] tracking-[0.1em] text-[#cbd5d0] transition-colors hover:border-[#8fa9a0] hover:text-[#f0eee5]\" data-kid=\"1-6-2-2\" id=\"btnProjects\"><i class=\"icon-folder-open text-[12px]\" data-kid=\"1-6-2-2-1\"></i> PROJECTS</button>\n<button class=\"flex items-center gap-[7px] border border-[#5d756d66] bg-[#071018cc] px-[10px] py-[6px] font-mono text-[9px] tracking-[0.1em] text-[#cbd5d0] transition-colors hover:border-[#8fa9a0] hover:text-[#f0eee5]\" data-kid=\"1-6-2-3\"><i class=\"icon-compass text-[12px]\" data-kid=\"1-6-2-3-1\"></i> FLIGHT SCHOOL</button>\n</div>\n</header>\n<div class=\"pointer-events-none absolute left-[62px] top-[104px] z-20\" data-kid=\"1-7\" id=\"intro\">\n<h1 class=\"font-serif text-[44px] leading-[1.02] tracking-[-0.035em] text-[#f4f0e7]\" data-kid=\"1-7-1\" style=\"font-family:Georgia,'Times New Roman',serif\">Nothing ends.<br data-kid=\"1-7-1-1\"/><span class=\"text-[#d9c29b]\" data-kid=\"1-7-1-2\" style=\"font-style:italic\">It transforms.</span></h1>\n<p class=\"mt-[14px] max-w-[268px] text-[12px] leading-[1.85] text-[#9faeb3]\" data-kid=\"1-7-2\">Abandoned projects finally get a home. Find your city, then give an idea its next life.</p>\n</div>\n<div class=\"absolute left-[62px] top-[110px] z-20 hidden w-[292px] border-l border-[#d2c29766] pl-[16px]\" data-kid=\"1-8\" id=\"surfaceId\">\n<p class=\"text-[34px] leading-[1.06] tracking-[-0.04em] text-[#f4e8d5]\" data-kid=\"1-8-1\" id=\"sName\" style=\"font-family:Georgia,'Times New Roman',serif\">AI City</p>\n<p class=\"mt-[10px] max-w-[250px] text-[11px] leading-[1.8] text-[#9fb0b4]\" data-kid=\"1-8-2\" id=\"sCopy\"></p>\n<div class=\"mt-[14px] flex items-center justify-between gap-[10px] font-mono text-[8px] tracking-[0.1em] text-[#7f939a]\" data-kid=\"1-8-3\"><span data-kid=\"1-8-3-1\">LANDMARK</span><span class=\"text-[#c3d0cd]\" data-kid=\"1-8-3-2\" id=\"sLandmark\"></span></div>\n<div class=\"mt-[6px] flex items-center justify-between gap-[10px] font-mono text-[8px] tracking-[0.1em] text-[#7f939a]\" data-kid=\"1-8-4\"><span data-kid=\"1-8-4-1\">RECORDS</span><span class=\"text-[#c3d0cd]\" data-kid=\"1-8-4-2\" id=\"sRecords\"></span></div>\n</div>\n<section class=\"absolute left-[62px] z-20 w-[300px] border border-[#79888245] bg-[#0c1a21f2] px-[20px] py-[18px]\" data-kid=\"1-9\" id=\"descent\" style=\"bottom:150px;border-top-color:var(--accent);border-radius:3px\">\n<div class=\"flex items-center justify-between font-mono text-[8px] tracking-[0.12em] text-[#8da3a7]\" data-kid=\"1-9-1\">\n<span data-kid=\"1-9-1-1\" id=\"cardIndex\">DESTINATION / 01</span><span data-kid=\"1-9-1-2\">11 DISTRICTS</span>\n</div>\n<h2 class=\"mt-[14px] flex items-start justify-between gap-2 text-[27px] leading-[1.15] tracking-[-0.03em] text-[#f0eee5]\" data-kid=\"1-9-2\" id=\"cardName\" style=\"font-family:Georgia,'Times New Roman',serif\">\n<span data-kid=\"1-9-2-1\" id=\"cardNameText\">AI City</span><i class=\"icon-arrow-down-right mt-[6px] text-[26px]\" data-kid=\"1-9-2-2\" style=\"color:var(--accent)\"></i>\n</h2>\n<p class=\"mt-[6px] min-h-[34px] max-w-[240px] text-[11px] leading-[1.7] text-[#a9b7ba]\" data-kid=\"1-9-3\" id=\"cardPurpose\">Connections can reveal possibilities no one noticed.</p>\n<div class=\"mt-[14px] flex items-center justify-between border-t border-[#7f9a9a26] pt-[10px] text-[10px] text-[#bbcdcb]\" data-kid=\"1-9-4\">\n<span class=\"font-mono text-[8px] tracking-[0.1em] text-[#6f8b91]\" data-kid=\"1-9-4-1\">LANDMARK</span><span data-kid=\"1-9-4-2\" id=\"cardLandmark\">Intelligence Core</span>\n</div>\n<button class=\"mt-[14px] flex w-full items-center justify-between bg-[#dfcead] px-[14px] py-[11px] text-[11px] font-semibold text-[#101a1d] transition hover:bg-[#fae6be]\" data-kid=\"1-9-5\" id=\"btnDescend\">\n<span data-kid=\"1-9-5-1\" id=\"descendLabel\">Descend into city</span><i class=\"icon-arrow-up-right text-[14px]\" data-kid=\"1-9-5-2\"></i>\n</button>\n<div class=\"mt-[9px] flex items-center justify-between font-mono text-[8px] tracking-[0.08em] text-[#81979c]\" data-kid=\"1-9-6\">\n<span data-kid=\"1-9-6-1\" id=\"cardCount\">24 PROJECTS</span>\n<span data-kid=\"1-9-6-2\">OR CLICK THE PLANET</span>\n</div>\n</section>\n<nav aria-label=\"Districts\" class=\"absolute inset-x-0 z-20 flex items-end gap-[4px] px-[62px]\" data-kid=\"1-10\" id=\"strip\" style=\"bottom:88px\"></nav>\n<div class=\"absolute inset-x-0 bottom-0 z-20 flex items-end justify-between px-[62px] pb-[22px]\" data-kid=\"1-11\">\n<div class=\"flex items-center gap-[16px] font-mono text-[8px] tracking-[0.12em] text-[#7d9096]\" data-kid=\"1-11-1\">\n<label class=\"pointer-events-auto flex cursor-pointer items-center gap-[7px]\" data-kid=\"1-11-1-1\"><input class=\"h-[10px] w-[10px] accent-[#dec599]\" data-kid=\"1-11-1-1-1\" id=\"lowFx\" type=\"checkbox\"/> REDUCED EFFECTS</label>\n<span class=\"text-[#5f747a]\" data-kid=\"1-11-1-2\" id=\"fps\">—</span>\n</div>\n<div class=\"flex items-center gap-[2px] border border-[#5d756d55] bg-[#0b1820eb] p-[5px]\" data-kid=\"1-11-2\">\n<button class=\"px-[10px] py-[5px] font-mono text-[9px] text-[#c3cdc7] hover:bg-[#7c88651f]\" data-kid=\"1-11-2-1\"><i class=\"icon-arrow-left mr-[5px] text-[10px]\" data-kid=\"1-11-2-1-1\"></i>ARCHIVE</button>\n<button class=\"px-[10px] py-[5px] font-mono text-[9px] text-[#c3cdc7] hover:bg-[#7c88651f]\" data-kid=\"1-11-2-2\">MY CITY</button>\n<button class=\"flex items-center gap-[6px] bg-[#7c88651f] px-[10px] py-[5px] font-mono text-[9px] text-[#dcd0b5]\" data-kid=\"1-11-2-3\"><i class=\"icon-store text-[11px]\" data-kid=\"1-11-2-3-1\"></i> BUILDING SHOP</button>\n</div>\n</div>\n<aside class=\"absolute right-[28px] z-30 w-[286px] translate-x-[8px] border border-[#617b7452] bg-[#0a1720f2] opacity-0 transition-all duration-300\" data-kid=\"1-12\" id=\"drawer\" style=\"top:96px;bottom:180px\">\n<div class=\"flex items-center justify-between border-b border-[#617b7433] px-[14px] py-[11px]\" data-kid=\"1-12-1\">\n<span class=\"font-mono text-[8px] tracking-[0.14em] text-[#a9bcba]\" data-kid=\"1-12-1-1\" id=\"drawerTitle\">PROJECTS / AI CITY</span>\n<button class=\"text-[#8fa3a7] hover:text-[#e8e2d4]\" data-kid=\"1-12-1-2\" id=\"drawerClose\"><i class=\"icon-x text-[12px]\" data-kid=\"1-12-1-2-1\"></i></button>\n</div>\n<div class=\"h-[calc(100%-38px)] overflow-y-auto py-[4px]\" data-kid=\"1-12-2\" id=\"drawerList\"></div>\n</aside>\n</div>\n<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n  #rb .font-serif{font-family:Georgia,'Times New Roman',serif}\n  #rb .font-mono{font-family:ui-monospace,'SF Mono',Menlo,monospace}\n  #rb canvas{display:block;width:100%!important;height:100%!important}\n  .mk{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:6px;padding:5px 7px 5px 5px;pointer-events:auto;cursor:pointer;background:rgba(5,13,19,.72);border:1px solid rgba(120,150,156,.28);transition:opacity .2s,border-color .2s,background .2s;white-space:nowrap}\n  .mk:hover{border-color:rgba(222,197,153,.75);background:rgba(12,26,33,.92)}\n  .mk[data-on=\"1\"]{border-color:var(--accent);background:rgba(10,26,33,.95)}\n  .mk i{width:5px;height:5px;display:block;border-radius:50%;flex:0 0 auto}\n  .mk span{font:9px/1 ui-monospace,monospace;letter-spacing:.08em;color:#dbe4e1;text-transform:uppercase}\n  .mk b{font:8px/1 ui-monospace,monospace;color:#7d9499;font-weight:400}\n  .mk[data-on=\"1\"] span{color:#f4f1e7}\n  .strip-btn{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px;padding:8px 9px 9px;border:1px solid rgba(72,96,107,.22);background:rgba(9,21,28,.86);text-align:left;transition:background .2s,border-color .2s}\n  .strip-btn:hover{background:rgba(23,49,58,.92);border-color:rgba(120,150,150,.4)}\n  .strip-btn[data-on=\"1\"]{background:rgba(27,48,57,.96);border-color:rgba(152,170,162,.55)}\n  .strip-btn u{display:block;height:1px;background:var(--c);opacity:.25;text-decoration:none;transition:opacity .2s}\n  .strip-btn[data-on=\"1\"] u,.strip-btn:hover u{opacity:1}\n  .strip-btn em{font:8px/1 ui-monospace,monospace;color:#84999e;font-style:normal}\n  .strip-btn strong{font:10px/1.1 'Inter',system-ui,sans-serif;color:#93a5a8;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  .strip-btn[data-on=\"1\"] strong{color:#e8ece5}\n  .rec{width:100%;display:flex;align-items:center;gap:10px;padding:8px 14px;text-align:left;transition:background .15s}\n  .rec:hover{background:rgba(255,255,255,.035)}\n  .rec .dt{width:5px;height:5px;border-radius:50%;flex:0 0 auto}\n  .rec .nm{flex:1;min-width:0;font-size:11.5px;color:#cfd7d2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  .rec .vw{font:8px/1 ui-monospace,monospace;color:#7e939a}\n</style>\n<script type=\"module\">\nimport * as THREE from 'https://esm.sh/three@0.169.0';\n\nconst D = [\n  {id:'AI',name:'AI City',short:'AI',accent:'#3DD8FF',sec:'#327dff',ground:'#070f1a',body:'#0b1826',landmark:'Intelligence Core',purpose:'Connections can reveal possibilities no one noticed.',projects:24},\n  {id:'Gaming',name:'Gaming City',short:'Gaming',accent:'#FFB547',sec:'#B44DFF',ground:'#140d0a',body:'#241726',landmark:'Infinite Arcade',purpose:'Explore the worlds that ideas could become.',projects:31},\n  {id:'Education',name:'Education City',short:'Education',accent:'#8fd9ff',sec:'#e6c79a',ground:'#081410',body:'#0a2018',landmark:'Knowledge Tree',purpose:'A failed attempt can still teach something valuable.',projects:18},\n  {id:'Health',name:'Health City',short:'Health',accent:'#68e7bd',sec:'#b5f3df',ground:'#0a1218',body:'#dceef5',landmark:'Regeneration Garden',purpose:'Give ideas the conditions they need to recover.',projects:12},\n  {id:'Creator',name:'Creative City',short:'Creative',accent:'#FF4DD8',sec:'#4D8CFF',ground:'#12081a',body:'#1a1024',landmark:'Imagination Engine',purpose:'Impossible ideas belong somewhere.',projects:27},\n  {id:'IdeaHub',name:'Revival City',short:'Revival',accent:'#5aebbf',sec:'#36dfc6',ground:'#0d0f0a',body:'#1a1a14',landmark:'Second Chance Engine',purpose:'Some ideas deserve another beginning.',projects:22},\n  {id:'Graveyard',name:'Graveyard',short:'Graveyard',accent:'#FF5959',sec:'#725178',ground:'#0a0808',body:'#141014',landmark:'Forgotten Archive',purpose:'Every abandoned idea leaves something behind.',projects:46},\n  {id:'Legend',name:'Success City',short:'Success',accent:'#FFD27A',sec:'#FFF8E8',ground:'#0d0f1a',body:'#1a1a20',landmark:'Legacy Spire',purpose:'The ideas that survived became landmarks.',projects:9},\n  {id:'Space',name:'Space City',short:'Space',accent:'#7bb8ff',sec:'#a58bff',ground:'#090d21',body:'#182746',landmark:'Cosmic Observatory',purpose:'The next possibility may be beyond the map.',projects:14},\n  {id:'Robotics',name:'Robotics City',short:'Robotics',accent:'#54efc0',sec:'#ffad53',ground:'#0c1418',body:'#20343d',landmark:'Forge Core',purpose:'Where unfinished machines find their purpose.',projects:16},\n  {id:'Community',name:'Community City',short:'Community',accent:'#50ddc5',sec:'#ffc88a',ground:'#101a1c',body:'#376366',landmark:'Common Ground',purpose:'No project has to be forgotten alone.',projects:20}\n];\n\nconst RECORDS = [\n  ['DeepLearn IDE','AI','reviving',1284,'2021–2024'],['VoiceNote AI','AI','abandoned',742,'2022–2023'],['CodeReview Bot','AI','abandoned',418,'2020–2022'],['Chat Widget SDK','AI','live',3120,'2019–2025'],\n  ['GameFi Protocol','Gaming','abandoned',5890,'2021–2022'],['Arena Forge','Gaming','paused',2406,'2021–2023'],['Pixel Dungeon X','Gaming','reviving',1012,'2018–2022'],\n  ['Lesson Loop','Education','abandoned',621,'2020–2023'],['Study Atlas','Education','live',2044,'2019–2026'],['Classroom Relay','Education','paused',388,'2022–2024'],\n  ['Vitals Bridge','Health','reviving',934,'2021–2024'],['Restwise','Health','abandoned',276,'2022–2023'],\n  ['Canvas Reel','Creator','paused',1663,'2020–2023'],['Sculpt Stream','Creator','abandoned',705,'2021–2022'],['Palette Sync','Creator','live',2890,'2018–2025'],\n  ['Second Draft','IdeaHub','reviving',1477,'2021–2024'],['Rebuild Kit','IdeaHub','abandoned',512,'2022–2023'],\n  ['CryptoVault Pro','Graveyard','abandoned',812,'2017–2019'],['SocialVR Alpha','Graveyard','abandoned',1904,'2019–2021'],['MetaShop 2023','Graveyard','abandoned',2455,'2022–2023'],['TaskFlow App','Graveyard','abandoned',661,'2020–2022'],\n  ['Founder Ledger','Legend','live',7420,'2016–2026'],['Handoff Notes','Legend','live',3108,'2018–2026'],\n  ['Orbital Relay','Space','reviving',1120,'2021–2024'],['Lunar Cartography','Space','paused',844,'2020–2023'],\n  ['Assembly Line 4','Robotics','reviving',966,'2021–2024'],['Grip Controller','Robotics','abandoned',433,'2022–2023'],\n  ['Common Table','Community','live',5044,'2017–2026'],['Neighbour Map','Community','reviving',1811,'2020–2024']\n];\nconst STATUS_COLOR = {abandoned:'#FF5959',reviving:'#5aebbf',paused:'#FFB547',live:'#8fd9ff'};\nconst STATUS_TEXT = {abandoned:'Abandoned',reviving:'Reviving',paused:'Paused',live:'Live'};\n\nconst root = document.getElementById('rb');\nconst stage = document.getElementById('stage');\nconst veil = document.getElementById('veil');\nconst markers = document.getElementById('markers');\n\nlet state = { index: 0, mode: 'orbit', diving: false, drawer: false, lowFx: false };\n\nfunction fail(msg){ const e=document.getElementById('err'); e.textContent = msg; e.classList.remove('hidden'); }\nwindow.addEventListener('error', ev => fail(ev.message || 'Render error'));\n\n/* ---------- renderer ---------- */\nconst renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\nrenderer.toneMapping = THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure = 1.02;\nrenderer.outputColorSpace = THREE.SRGBColorSpace;\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\nstage.appendChild(renderer.domElement);\n\nconst camera = new THREE.PerspectiveCamera(44, 1, 0.5, 3000);\ncamera.position.set(0, 24, 126);\n\nfunction resize(){\n  const w = stage.clientWidth || 1440, h = stage.clientHeight || 840;\n  renderer.setSize(w, h, false);\n  camera.aspect = w / h; camera.updateProjectionMatrix();\n}\nwindow.addEventListener('resize', resize);\n\n/* ---------- procedural environment (reflections, no image assets) ---------- */\nfunction equirect(top, horizon, ground, sunHex, sunSharp){\n  const w = 256, h = 128, data = new Uint8Array(w * h * 4);\n  const cT = new THREE.Color(top), cH = new THREE.Color(horizon), cG = new THREE.Color(ground), cS = new THREE.Color(sunHex);\n  const tmp = new THREE.Color();\n  for (let y = 0; y < h; y++){\n    const v = y / h;\n    for (let x = 0; x < w; x++){\n      if (v < 0.5) tmp.copy(cT).lerp(cH, Math.pow(v / 0.5, 0.62));\n      else tmp.copy(cH).lerp(cG, Math.min(1, (v - 0.5) / 0.32));\n      const du = Math.abs(x / w - 0.7) * 2, dv = v - 0.34;\n      const dd = Math.sqrt(du * du + dv * dv * 2.4);\n      const glow = Math.pow(Math.max(0, 1 - dd * 2.6), 3) * sunSharp;\n      tmp.lerp(cS, Math.min(1, glow));\n      const i = (y * w + x) * 4;\n      data[i] = Math.min(255, tmp.r * 255); data[i+1] = Math.min(255, tmp.g * 255); data[i+2] = Math.min(255, tmp.b * 255); data[i+3] = 255;\n    }\n  }\n  const tex = new THREE.DataTexture(data, w, h, THREE.RGBAFormat);\n  tex.mapping = THREE.EquirectangularReflectionMapping;\n  tex.colorSpace = THREE.LinearSRGBColorSpace;\n  tex.needsUpdate = true;\n  return tex;\n}\nconst pmrem = new THREE.PMREMGenerator(renderer);\nconst orbitalEnv = pmrem.fromEquirectangular(equirect('#04070f', '#12303c', '#03060b', '#ffd6a3', 0.85)).texture;\n\n/* ---------- shared geometry helpers ---------- */\nfunction roundedRect(w, h, r){\n  const s = new THREE.Shape();\n  s.moveTo(-w/2 + r, -h/2);\n  s.lineTo(w/2 - r, -h/2); s.quadraticCurveTo(w/2, -h/2, w/2, -h/2 + r);\n  s.lineTo(w/2, h/2 - r);  s.quadraticCurveTo(w/2, h/2, w/2 - r, h/2);\n  s.lineTo(-w/2 + r, h/2); s.quadraticCurveTo(-w/2, h/2, -w/2, h/2 - r);\n  s.lineTo(-w/2, -h/2 + r);s.quadraticCurveTo(-w/2, -h/2, -w/2 + r, -h/2);\n  return s;\n}\nconst plateGeo = new THREE.ExtrudeGeometry(roundedRect(1, 1, 0.16), { depth: 0.3, bevelEnabled: true, bevelThickness: 0.05, bevelSize: 0.05, bevelSegments: 1, curveSegments: 2 });\nplateGeo.center();\n\n/* CPU noise so plates and towers can sit on land only */\nfunction hash3(x, y, z){ const n = Math.sin(x * 127.1 + y * 311.7 + z * 74.7) * 43758.5453; return n - Math.floor(n); }\nfunction vnoise(x, y, z){\n  const xi = Math.floor(x), yi = Math.floor(y), zi = Math.floor(z);\n  const xf = x - xi, yf = y - yi, zf = z - zi;\n  const u = xf*xf*(3-2*xf), v = yf*yf*(3-2*yf), w = zf*zf*(3-2*zf);\n  const c000 = hash3(xi,yi,zi), c100 = hash3(xi+1,yi,zi), c010 = hash3(xi,yi+1,zi), c110 = hash3(xi+1,yi+1,zi);\n  const c001 = hash3(xi,yi,zi+1), c101 = hash3(xi+1,yi,zi+1), c011 = hash3(xi,yi+1,zi+1), c111 = hash3(xi+1,yi+1,zi+1);\n  const x00 = c000 + (c100-c000)*u, x10 = c010 + (c110-c010)*u, x01 = c001 + (c101-c001)*u, x11 = c011 + (c111-c011)*u;\n  const y0 = x00 + (x10-x00)*v, y1 = x01 + (x11-x01)*v;\n  return y0 + (y1-y0)*w;\n}\nfunction fbm3(x, y, z, oct){\n  let a = 0.5, s = 0;\n  for (let i = 0; i < (oct||4); i++){ s += a * vnoise(x, y, z); x *= 2.03; y *= 2.03; z *= 2.03; a *= 0.5; }\n  return s;\n}\nfunction landAt(v){\n  const continents = fbm3(v.x * 1.62 + 4, v.y * 1.62 + 4, v.z * 1.62 + 4, 5);\n  const ridges = fbm3(v.x * 5.4 + 11, v.y * 5.4 + 11, v.z * 5.4 + 11, 5);\n  return continents + ridges * 0.09;\n}\n\n/* ---------- orbital scene ---------- */\nconst scene = new THREE.Scene();\nscene.environment = orbitalEnv;\nconst R = 30;\nconst SUN = new THREE.Vector3(0.58, 0.36, 0.74).normalize();\n\nconst world = new THREE.Group();\nworld.position.set(15, 2, 0);\nscene.add(world);\n\nconst planetMat = new THREE.ShaderMaterial({\n  uniforms: {\n    uSun: { value: SUN }, uTime: { value: 0 },\n    uOcean: { value: new THREE.Color('#0a2436') },\n    uLandA: { value: new THREE.Color('#22333a') },\n    uLandB: { value: new THREE.Color('#786748') },\n    uAccent: { value: new THREE.Color('#9fdcEA') }\n  },\n  vertexShader: `\n    varying vec3 vObj; varying vec3 vN; varying vec3 vV;\n    void main(){\n      vObj = normalize(position);\n      vN = normalize(mat3(modelMatrix) * normal);\n      vec4 wp = modelMatrix * vec4(position, 1.0);\n      vV = normalize(cameraPosition - wp.xyz);\n      gl_Position = projectionMatrix * viewMatrix * wp;\n    }`,\n  fragmentShader: `\n    #include <common>\n    #include <dithering_pars_fragment>\n    varying vec3 vObj; varying vec3 vN; varying vec3 vV;\n    uniform vec3 uSun; uniform vec3 uOcean; uniform vec3 uLandA; uniform vec3 uLandB; uniform vec3 uAccent; uniform float uTime;\n    float h(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }\n    float n(vec3 x){\n      vec3 i = floor(x), f = fract(x); f = f * f * (3.0 - 2.0 * f);\n      return mix(mix(mix(h(i), h(i + vec3(1,0,0)), f.x), mix(h(i + vec3(0,1,0)), h(i + vec3(1,1,0)), f.x), f.y),\n                 mix(mix(h(i + vec3(0,0,1)), h(i + vec3(1,0,1)), f.x), mix(h(i + vec3(0,1,1)), h(i + vec3(1,1,1)), f.x), f.y), f.z);\n    }\n    float fbm(vec3 p){ float a = 0.5, s = 0.0; for (int i = 0; i < 5; i++){ s += a * n(p); p *= 2.03; a *= 0.5; } return s; }\n    void main(){\n      vec3 nrm = normalize(vN);\n      vec3 view = normalize(vV);\n      float continents = fbm(vObj * 1.62 + 4.0);\n      float ridges = fbm(vObj * 5.4 + 11.0);\n      float land = smoothstep(0.5, 0.585, continents + ridges * 0.09);\n      vec3 ground = mix(uLandA, uLandB, smoothstep(0.3, 0.86, ridges));\n      vec3 ocean = uOcean * (0.66 + 0.5 * smoothstep(0.18, 0.5, continents));\n      vec3 albedo = mix(ocean, ground, land);\n      albedo = mix(albedo, albedo * vec3(1.22, 1.1, 0.86), smoothstep(0.6, 0.97, abs(vObj.y)) * 0.36);\n      float clouds = smoothstep(0.54, 0.86, fbm(vObj * 4.6 + 21.0)) * smoothstep(0.02, 0.32, continents);\n      albedo = mix(albedo, vec3(0.66, 0.72, 0.76), clouds * 0.34);\n      float day = clamp(dot(nrm, uSun), 0.0, 1.0);\n      float term = smoothstep(-0.14, 0.26, dot(nrm, uSun));\n      vec3 halfV = normalize(uSun + view);\n      float spec = pow(max(dot(nrm, halfV), 0.0), 260.0) * (1.0 - land) * 1.15 * smoothstep(0.0, 0.45, day);\n      vec3 color = albedo * (day * 1.02 + 0.035);\n      color += vec3(1.0, 0.87, 0.68) * spec;\n      float cells = smoothstep(0.76, 0.99, fbm(vObj * 34.0) * 0.48 + h(floor(vObj * 330.0)) * 0.56);\n      float lights = cells * land * (1.0 - term);\n      color += vec3(1.0, 0.83, 0.58) * lights * 0.85;\n      float fres = pow(1.0 - max(dot(nrm, view), 0.0), 3.1);\n      color += uAccent * fres * (0.16 + day * 0.5) * 0.5;\n      gl_FragColor = vec4(color, 1.0);\n      #include <tonemapping_fragment>\n      #include <colorspace_fragment>\n      #include <dithering_fragment>\n    }`\n});\nconst planet = new THREE.Mesh(new THREE.SphereGeometry(R, 160, 110), planetMat);\nworld.add(planet);\n\n/* atmospheric limb */\nconst atmoMat = new THREE.ShaderMaterial({\n  uniforms: { uColor: { value: new THREE.Color('#9fd8e6') }, uSun: { value: SUN } },\n  vertexShader: `varying vec3 vN; varying vec3 vV; varying vec3 vWN;\n    void main(){ vN = normalize(normalMatrix * normal); vec4 wp = modelMatrix * vec4(position,1.0); vV = normalize(cameraPosition - wp.xyz); vWN = normalize(mat3(modelMatrix)*normal); gl_Position = projectionMatrix * viewMatrix * wp; }`,\n  fragmentShader: `varying vec3 vN; varying vec3 vV; varying vec3 vWN; uniform vec3 uColor; uniform vec3 uSun;\n    void main(){ float f = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), 4.0); float lit = smoothstep(-0.45, 0.55, dot(normalize(vWN), uSun)); gl_FragColor = vec4(uColor, f * (0.16 + lit * 0.62)); }`,\n  transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.FrontSide\n});\nconst atmo = new THREE.Mesh(new THREE.SphereGeometry(R * 1.055, 96, 64), atmoMat);\nworld.add(atmo);\nconst atmoOuter = new THREE.Mesh(new THREE.SphereGeometry(R * 1.14, 64, 48), new THREE.ShaderMaterial({\n  uniforms: { uColor: { value: new THREE.Color('#5aa8c4') }, uSun: { value: SUN } },\n  vertexShader: `varying vec3 vN; varying vec3 vV; varying vec3 vWN;\n    void main(){ vN = normalize(normalMatrix * normal); vec4 wp = modelMatrix * vec4(position,1.0); vV = normalize(cameraPosition - wp.xyz); vWN = normalize(mat3(modelMatrix)*normal); gl_Position = projectionMatrix * viewMatrix * wp; }`,\n  fragmentShader: `varying vec3 vN; varying vec3 vV; varying vec3 vWN; uniform vec3 uColor; uniform vec3 uSun;\n    void main(){ float f = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), 7.0); float lit = smoothstep(-0.6, 0.5, dot(normalize(vWN), uSun)); gl_FragColor = vec4(uColor, f * lit * 0.3); }`,\n  transparent: true, blending: THREE.AdditiveBlending, depthWrite: false\n}));\nworld.add(atmoOuter);\n\n/* structural crust plates */\nconst platesMat = new THREE.MeshStandardMaterial({ color: '#ffffff', metalness: 0.44, roughness: 0.62, envMapIntensity: 0.85 });\nconst plateDummy = new THREE.Object3D();\nconst plateList = [];\nconst upZ = new THREE.Vector3(0, 0, 1);\nconst ROWS = 38, COLS = 38;\nconst east = new THREE.Vector3(), north = new THREE.Vector3(), basis = new THREE.Matrix4();\nfunction placePlates(){\n  for (let row = 0; row < ROWS; row++){\n    const lat = -1.3 + (row + 0.5) / ROWS * 2.6;\n    const count = Math.max(4, Math.round(COLS * Math.cos(lat)));\n    for (let c = 0; c < count; c++){\n      const lon = (c + (row % 2) * 0.5) / count * Math.PI * 2;\n      const normal = new THREE.Vector3(Math.cos(lon) * Math.cos(lat), Math.sin(lat), Math.sin(lon) * Math.cos(lat)).normalize();\n      if (landAt(normal) < 0.535) continue;\n      const rnd = hash3(normal.x * 41.3, normal.y * 57.7, normal.z * 33.1);\n      east.crossVectors(new THREE.Vector3(0, 1, 0), normal).normalize();\n      if (east.lengthSq() < 0.001) east.set(1, 0, 0);\n      north.crossVectors(normal, east).normalize();\n      basis.makeBasis(east, north, normal);\n      plateDummy.quaternion.setFromRotationMatrix(basis);\n      const cellW = (Math.PI * 2 * Math.cos(lat)) / count * R * 0.9;\n      const cellH = (2.6 / ROWS) * R * 0.9;\n      const thick = rnd > 0.965 ? 1.5 : (0.22 + rnd * 0.34);\n      plateDummy.position.copy(normal).multiplyScalar(R + 0.1 + (thick - 0.2) * 0.5 + (rnd > 0.9 ? 0.26 : 0));\n      plateDummy.scale.set(Math.max(0.34, cellW), Math.max(0.34, cellH), thick);\n      plateDummy.updateMatrix();\n      plateList.push(plateDummy.matrix.clone());\n    }\n  }\n}\nplacePlates();\nconst plateMesh = new THREE.InstancedMesh(plateGeo, platesMat, plateList.length);\nconst plateTone = new THREE.Color();\nplateList.forEach((m, i) => {\n  plateMesh.setMatrixAt(i, m);\n  const r = hash3(i * 7.31, i * 2.17, i * 5.03);\n  const warmPlate = r > 0.955;\n  plateTone.set(warmPlate ? '#6f6551' : r > 0.62 ? '#4f6870' : r > 0.34 ? '#3f565f' : '#31474f');\n  plateTone.multiplyScalar(0.82 + r * 0.34);\n  plateMesh.setColorAt(i, plateTone);\n});\nplateMesh.instanceMatrix.needsUpdate = true;\nif (plateMesh.instanceColor) plateMesh.instanceColor.needsUpdate = true;\nplateMesh.receiveShadow = false;\nworld.add(plateMesh);\n\n/* fine roof detail */\nconst roofGeo = new THREE.BoxGeometry(0.5, 0.24, 0.5);\nconst roofList = [];\n{\n  const dummy = new THREE.Object3D();\n  for (let i = 0; i < plateList.length; i++){\n    if (i % 3 !== 0) continue;\n    const m = plateList[i];\n    const p = new THREE.Vector3().setFromMatrixPosition(m);\n    const normal = p.clone().normalize();\n    const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);\n    const rnd = hash3(p.x * 12.7, p.y * 31.1, p.z * 91.3);\n    dummy.position.copy(normal).multiplyScalar(p.length() + 0.5 + rnd * 0.35);\n    dummy.quaternion.copy(q);\n    dummy.scale.set(0.7 + rnd, 0.8 + rnd * 0.9, 0.7 + rnd * 0.6);\n    dummy.updateMatrix();\n    roofList.push(dummy.matrix.clone());\n  }\n}\nconst roofMesh = new THREE.InstancedMesh(roofGeo, new THREE.MeshStandardMaterial({ color: '#496066', metalness: 0.7, roughness: 0.42, envMapIntensity: 1.1 }), roofList.length);\nroofList.forEach((m, i) => roofMesh.setMatrixAt(i, m));\nroofMesh.instanceMatrix.needsUpdate = true;\nworld.add(roofMesh);\n\n/* district anchors + territories */\nconst anchors = D.map((d, i) => {\n  const y = 1 - 2 * (i + 0.5) / D.length;\n  const a = i * 2.39996323 + 0.6;\n  const r = Math.sqrt(Math.max(0, 1 - y * y));\n  return new THREE.Vector3(Math.cos(a) * r, y * 0.92, Math.sin(a) * r).normalize();\n});\nconst towerGeo = new THREE.BoxGeometry(1, 1, 1);\nconst towerDummy = new THREE.Object3D();\nconst towerMats = [];\nconst towerColors = [];\n{\n  const tmpN = new THREE.Vector3(), tangent = new THREE.Vector3(), bitan = new THREE.Vector3();\n  anchors.forEach((anchor, di) => {\n    const d = D[di];\n    const clusterCount = 34;\n    const tangentA = new THREE.Vector3(0, 1, 0).cross(anchor).normalize();\n    const tangentB = anchor.clone().cross(tangentA).normalize();\n    for (let k = 0; k < clusterCount; k++){\n      const r1 = hash3(anchor.x * 7 + k * 3.3, anchor.y * 5 + k, anchor.z * 9 + k * 2.1);\n      const r2 = hash3(anchor.z * 11 + k * 5.1, anchor.x * 3 + k, anchor.y * 13 + k);\n      const spread = 0.085 + Math.sqrt(r1) * 0.09;\n      const angle = r2 * Math.PI * 2;\n      tmpN.copy(anchor).addScaledVector(tangentA, Math.cos(angle) * spread).addScaledVector(tangentB, Math.sin(angle) * spread).normalize();\n      const h = 0.8 + Math.pow(r1, 2.1) * 5.2 + (k % 7 === 0 ? 2.4 : 0);\n      const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), tmpN);\n      towerDummy.position.copy(tmpN).multiplyScalar(R + h * 0.5 + 0.5 + Math.sin(r1 * 10) * 0.2);\n      towerDummy.quaternion.copy(q);\n      towerDummy.scale.set(0.28 + r2 * 0.3, h, 0.3 + r1 * 0.26);\n      towerDummy.updateMatrix();\n      towerMats.push(towerDummy.matrix.clone());\n      const c = new THREE.Color();\n      if (k % 9 === 0) c.set(d.accent);\n      else if (k % 4 === 0) c.set('#7f9aa0');\n      else c.set('#334c54');\n      towerColors.push(c);\n    }\n  });\n}\nconst towers = new THREE.InstancedMesh(towerGeo, new THREE.MeshStandardMaterial({ metalness: 0.66, roughness: 0.44, envMapIntensity: 1.15 }), towerMats.length);\ntowerMats.forEach((m, i) => { towers.setMatrixAt(i, m); towers.setColorAt(i, towerColors[i]); });\ntowers.instanceMatrix.needsUpdate = true;\nif (towers.instanceColor) towers.instanceColor.needsUpdate = true;\nworld.add(towers);\n\n/* district beacons */\nconst beaconGroup = new THREE.Group();\nworld.add(beaconGroup);\nconst beaconMeshes = D.map((d, i) => {\n  const g = new THREE.Group();\n  const dot = new THREE.Mesh(new THREE.OctahedronGeometry(0.42, 0), new THREE.MeshBasicMaterial({ color: new THREE.Color(d.accent), toneMapped: false }));\n  const halo = new THREE.Mesh(new THREE.RingGeometry(0.75, 0.86, 40), new THREE.MeshBasicMaterial({ color: new THREE.Color(d.accent), transparent: true, opacity: 0.42, side: THREE.DoubleSide, toneMapped: false, depthWrite: false }));\n  g.add(dot, halo);\n  const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 0, 1), anchors[i]);\n  g.position.copy(anchors[i]).multiplyScalar(R + 1.6);\n  g.quaternion.copy(q);\n  beaconGroup.add(g);\n  return g;\n});\n\n/* rings + station trusses */\nconst ringGroup = new THREE.Group();\nringGroup.rotation.set(1.06, 0.3, -0.22);\nworld.add(ringGroup);\nconst warm = new THREE.MeshStandardMaterial({ color: '#cbb083', metalness: 0.85, roughness: 0.32, envMapIntensity: 1.25 });\nconst steel = new THREE.MeshStandardMaterial({ color: '#54696e', metalness: 0.9, roughness: 0.34, envMapIntensity: 1.2 });\nconst ringBands = [40.5, 43.2, 50.4];\nringBands.forEach((rad, i) => {\n  const band = new THREE.Mesh(new THREE.TorusGeometry(rad, i === 1 ? 0.22 : 0.1, 8, 220), i === 1 ? steel : warm);\n  band.rotation.x = Math.PI / 2;\n  ringGroup.add(band);\n});\nconst trussGeo = new THREE.BoxGeometry(1, 1, 1);\nconst trussMat = new THREE.MeshStandardMaterial({ color: '#37474d', metalness: 0.82, roughness: 0.48, envMapIntensity: 0.55 });\nconst trussMesh = new THREE.InstancedMesh(trussGeo, trussMat, 72);\n{\n  const dummy = new THREE.Object3D();\n  for (let i = 0; i < 72; i++){\n    const a = (i / 72) * Math.PI * 2;\n    const radial = i % 3 === 0 ? 43.2 : 40.5;\n    dummy.position.set(Math.sin(a) * radial, 0, Math.cos(a) * radial);\n    dummy.rotation.set(0, a + Math.PI / 2, 0);\n    dummy.scale.set(0.2, 0.07, 0.58);\n    dummy.updateMatrix();\n    trussMesh.setMatrixAt(i, dummy.matrix);\n  }\n  trussMesh.instanceMatrix.needsUpdate = true;\n}\nringGroup.add(trussMesh);\nconst dockingGlow = new THREE.MeshBasicMaterial({ color: new THREE.Color('#ffdcae'), toneMapped: false });\nfor (let i = 0; i < 6; i++){\n  const a = (i / 6) * Math.PI * 2 + 0.3;\n  const bay = new THREE.Mesh(new THREE.BoxGeometry(3.4, 0.9, 2.2), steel);\n  bay.position.set(Math.sin(a) * 43.2, 0, Math.cos(a) * 43.2);\n  bay.rotation.y = a;\n  ringGroup.add(bay);\n  const win = new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.16, 0.5), dockingGlow);\n  win.position.copy(bay.position).add(new THREE.Vector3(0, 0.55, 0));\n  win.rotation.y = a;\n  ringGroup.add(win);\n}\n\n/* satellite */\nconst sat = new THREE.Group();\nsat.add(new THREE.Mesh(new THREE.OctahedronGeometry(0.7, 0), steel));\nconst panelMat = new THREE.MeshStandardMaterial({ color: '#22384a', metalness: 0.85, roughness: 0.22, envMapIntensity: 1.4 });\n[-1, 1].forEach(s => { const p = new THREE.Mesh(new THREE.BoxGeometry(3.2, 0.06, 1.4), panelMat); p.position.x = s * 2.2; sat.add(p); });\nringGroup.add(sat);\n\n/* moon */\nconst moon = new THREE.Mesh(new THREE.SphereGeometry(4.6, 36, 28), new THREE.MeshStandardMaterial({ color: '#4a5560', roughness: 0.92, metalness: 0.14, envMapIntensity: 0.7, emissive: new THREE.Color('#0a1218'), emissiveIntensity: 1 }));\nmoon.position.set(-58, 24, -84);\nscene.add(moon);\n\n/* star field */\n{\n  const count = 1600, pos = new Float32Array(count * 3), col = new Float32Array(count * 3), size = new Float32Array(count);\n  for (let i = 0; i < count; i++){\n    const a = i * 2.399963, y = 1 - 2 * (i + 0.5) / count, r = Math.sqrt(Math.max(0, 1 - y * y)), rad = 620 + (i % 17) * 9;\n    pos.set([Math.cos(a) * r * rad, y * rad, Math.sin(a) * r * rad], i * 3);\n    const warmStar = i % 11 === 0;\n    const b = 0.5 + (i % 7) * 0.07;\n    col.set(warmStar ? [1, 0.84, 0.62] : [0.72, 0.85, 1], i * 3);\n    col[i*3] *= b; col[i*3+1] *= b; col[i*3+2] *= b;\n    size[i] = i % 13 === 0 ? 2.6 : i % 5 === 0 ? 1.5 : 0.95;\n  }\n  const g = new THREE.BufferGeometry();\n  g.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n  g.setAttribute('color', new THREE.BufferAttribute(col, 3));\n  g.setAttribute('aSize', new THREE.BufferAttribute(size, 1));\n  const m = new THREE.ShaderMaterial({\n    uniforms: {},\n    vertexShader: `attribute float aSize; varying vec3 vC; varying float vS;\n      void main(){ vC = color; vS = aSize; vec4 mv = modelViewMatrix * vec4(position,1.0); gl_PointSize = aSize * (300.0 / -mv.z); gl_Position = projectionMatrix * mv; }`,\n    fragmentShader: `varying vec3 vC; varying float vS;\n      void main(){ float d = length(gl_PointCoord - vec2(0.5)); if(d > 0.5) discard; float a = smoothstep(0.5, 0.06, d); gl_FragColor = vec4(vC, a * (0.55 + vS * 0.18)); }`,\n    transparent: true, depthWrite: false, vertexColors: true, blending: THREE.AdditiveBlending\n  });\n  const stars = new THREE.Points(g, m);\n  stars.frustumCulled = false;\n  scene.add(stars);\n}\n\n/* lights for the constructed shells */\nscene.add(new THREE.AmbientLight('#1b2b33', 1.1));\nconst key = new THREE.DirectionalLight('#ffe3c2', 2.4);\nkey.position.copy(SUN).multiplyScalar(180);\nscene.add(key);\nconst rimLight = new THREE.DirectionalLight('#5aa9d6', 1.1);\nrimLight.position.set(-120, -40, -90);\nscene.add(rimLight);\n\n/* ---------- surface scene ---------- */\nconst surface = new THREE.Scene();\nconst surfaceRoot = new THREE.Group();\nsurface.add(surfaceRoot);\nlet surfaceEnv = null;\nlet surfaceLights = null;\n\nfunction buildSurface(d){\n  surfaceRoot.clear();\n  const bg = d.ground;\n  surface.fog = new THREE.FogExp2(bg, 0.0055);\n  surface.background = new THREE.Color(bg);\n  if (surfaceEnv) surfaceEnv.dispose();\n  surfaceEnv = pmrem.fromEquirectangular(equirect(d.body, d.body, '#03060a', d.sec, 0.35)).texture;\n  surface.environment = surfaceEnv;\n\n  const stone = new THREE.MeshStandardMaterial({ color: new THREE.Color(d.body).lerp(new THREE.Color('#81908f'), 0.52), metalness: 0.16, roughness: 0.7, envMapIntensity: 0.95 });\n  const metal = new THREE.MeshStandardMaterial({ color: '#5b6d70', metalness: 0.86, roughness: 0.34, envMapIntensity: 1.35 });\n  const dark = new THREE.MeshStandardMaterial({ color: '#0c1418', metalness: 0.4, roughness: 0.6, envMapIntensity: 0.7 });\n  const glow = new THREE.MeshBasicMaterial({ color: new THREE.Color(d.accent), toneMapped: false });\n  const warmGlow = new THREE.MeshBasicMaterial({ color: new THREE.Color('#ffcf9a'), toneMapped: false });\n\n  const ground = new THREE.Mesh(new THREE.CircleGeometry(150, 72), stone);\n  ground.rotation.x = -Math.PI / 2;\n  ground.receiveShadow = true;\n  surfaceRoot.add(ground);\n\n  const plaza = new THREE.Mesh(new THREE.CylinderGeometry(16, 17, 1.2, 64), new THREE.MeshStandardMaterial({ color: new THREE.Color(d.body).multiplyScalar(1.05), metalness: 0.2, roughness: 0.6, envMapIntensity: 0.9 }));\n  plaza.position.y = 0.6; plaza.receiveShadow = true; plaza.castShadow = true;\n  surfaceRoot.add(plaza);\n  for (let i = 1; i <= 3; i++){\n    const step = new THREE.Mesh(new THREE.CylinderGeometry(16 + i * 3.4, 17 + i * 3.4, 0.34, 64), dark);\n    step.position.y = 0.17 - i * 0.12;\n    step.receiveShadow = true;\n    surfaceRoot.add(step);\n  }\n  const rim = new THREE.Mesh(new THREE.TorusGeometry(16.2, 0.09, 6, 96), glow);\n  rim.rotation.x = Math.PI / 2; rim.position.y = 1.22;\n  surfaceRoot.add(rim);\n\n  /* buildings */\n  const bodyGeo = new THREE.BoxGeometry(1, 1, 1);\n  const bodies = [], wins = [], beacons = [];\n  const dummy = new THREE.Object3D();\n  const rand = (i) => hash3(Math.cos(i * 12.9898) * 43758.5, Math.sin(i * 78.233) * 12345.6, i * 0.37);\n  for (let i = 0; i < 96; i++){\n    const r1 = rand(i + 1), r2 = rand(i + 41), r3 = rand(i + 91), r4 = rand(i + 137);\n    const ring = 26 + Math.floor(r1 * 5) * 12;\n    const a = r2 * Math.PI * 2;\n    if (Math.abs(Math.sin(a * 2)) < 0.12) continue;\n    const w = 3.6 + r3 * 5.5, h = 4 + Math.pow(r4, 2.1) * 24 + (r1 > 0.86 ? 16 : 0), dp = 3.6 + r3 * 4.4;\n    const x = Math.cos(a) * (ring + (r4 - 0.5) * 7), z = Math.sin(a) * (ring + (r4 - 0.5) * 7);\n    dummy.position.set(x, h / 2, z);\n    dummy.rotation.set(0, a + (r1 - 0.5) * 0.8, 0);\n    dummy.scale.set(w, h, dp);\n    dummy.updateMatrix();\n    bodies.push(dummy.matrix.clone());\n    const floors = Math.max(2, Math.floor(h / 3.6));\n    for (let f = 0; f < floors; f++){\n      const wy = 2.6 + f * 3.5;\n      if (wy > h - 1.2) break;\n      const lit = hash3(i * 5.1 + 3, f * 7.3, r2 * 9.1);\n      if (lit < 0.52) continue;\n      for (const side of [-1, 1]){\n        dummy.position.set(x + Math.sin(a) * (dp / 2 + 0.08) * side, wy, z + Math.cos(a) * (dp / 2 + 0.08) * side);\n        dummy.rotation.set(0, a, 0);\n        dummy.scale.set(w * (0.52 + lit * 0.26), 0.2, 0.08);\n        dummy.updateMatrix();\n        wins.push(dummy.matrix.clone());\n      }\n    }\n    if (r1 > 0.55){\n      dummy.position.set(x, h + 0.5, z);\n      dummy.rotation.set(0, 0, 0);\n      dummy.scale.set(0.3, 0.9, 0.3);\n      dummy.updateMatrix();\n      beacons.push(dummy.matrix.clone());\n    }\n  }\n  const bodyMesh = new THREE.InstancedMesh(bodyGeo, stone, bodies.length);\n  bodies.forEach((m, i) => bodyMesh.setMatrixAt(i, m));\n  bodyMesh.instanceMatrix.needsUpdate = true;\n  bodyMesh.castShadow = true; bodyMesh.receiveShadow = true;\n  surfaceRoot.add(bodyMesh);\n\n  const winMesh = new THREE.InstancedMesh(bodyGeo, warmGlow, wins.length);\n  wins.forEach((m, i) => winMesh.setMatrixAt(i, m));\n  winMesh.instanceMatrix.needsUpdate = true;\n  surfaceRoot.add(winMesh);\n\n  const beaconMesh = new THREE.InstancedMesh(new THREE.SphereGeometry(0.28, 8, 6), glow, beacons.length);\n  beacons.forEach((m, i) => beaconMesh.setMatrixAt(i, m));\n  beaconMesh.instanceMatrix.needsUpdate = true;\n  surfaceRoot.add(beaconMesh);\n\n  /* landmark at the centre */\n  const lm = new THREE.Group();\n  lm.position.y = 1.2;\n  surfaceRoot.add(lm);\n  const add = (geo, mat, x, y, z, rx, ry, rz) => {\n    const m = new THREE.Mesh(geo, mat);\n    m.position.set(x, y, z); m.rotation.set(rx || 0, ry || 0, rz || 0);\n    m.castShadow = true; m.receiveShadow = true;\n    lm.add(m); return m;\n  };\n  switch (d.id){\n    case 'AI': {\n      add(new THREE.CylinderGeometry(5.4, 6.4, 1.4, 8), metal, 0, 0.7, 0);\n      add(new THREE.TorusGeometry(4.2, 0.34, 10, 48), metal, 0, 12, 0, Math.PI / 2, 0, 0);\n      add(new THREE.TorusGeometry(6.1, 0.2, 8, 64), glow, 0, 12.6, 0, 0.5, 0.3, 0.4);\n      add(new THREE.IcosahedronGeometry(2.5, 1), new THREE.MeshStandardMaterial({ color: '#0e2c38', metalness: 0.4, roughness: 0.3, emissive: new THREE.Color(d.accent), emissiveIntensity: 1.1 }), 0, 12, 0);\n      for (let i = 0; i < 4; i++){\n        const a = i / 4 * Math.PI * 2;\n        add(new THREE.BoxGeometry(0.7, 11, 0.7), metal, Math.cos(a) * 5.6, 6, Math.sin(a) * 5.6);\n      }\n      break;\n    }\n    case 'Graveyard': {\n      for (let i = 0; i < 9; i++){\n        const a = (i / 9) * Math.PI * 2, rr = 2.4 + (i % 3) * 2.1;\n        const hh = 6 + (i % 4) * 3.4;\n        add(new THREE.BoxGeometry(1.5, hh, 1.5), i % 3 === 0 ? metal : new THREE.MeshStandardMaterial({ color: '#4a4048', metalness: 0.2, roughness: 0.9 }), Math.cos(a) * rr, hh / 2, Math.sin(a) * rr, (i % 3 - 1) * 0.16, a, (i % 2 ? 1 : -1) * 0.13);\n      }\n      add(new THREE.RingGeometry(7.4, 8.1, 64), new THREE.MeshBasicMaterial({ color: new THREE.Color(d.accent), transparent: true, opacity: 0.3, side: THREE.DoubleSide, toneMapped: false, depthWrite: false }), 0, 0.1, 0, -Math.PI / 2, 0, 0);\n      break;\n    }\n    case 'Legend': {\n      add(new THREE.CylinderGeometry(7.4, 8.4, 1.6, 48), stone, 0, 0.8, 0);\n      add(new THREE.CylinderGeometry(1.5, 2.6, 26, 8), new THREE.MeshStandardMaterial({ color: '#cfc4a8', metalness: 0.3, roughness: 0.55, envMapIntensity: 1 }), 0, 14, 0);\n      add(new THREE.ConeGeometry(1.6, 5.4, 8), glow, 0, 29.5, 0);\n      for (let i = 0; i < 8; i++){\n        const a = i / 8 * Math.PI * 2;\n        add(new THREE.CylinderGeometry(0.32, 0.4, 13, 8), metal, Math.cos(a) * 6.2, 6.5, Math.sin(a) * 6.2);\n      }\n      break;\n    }\n    default: {\n      add(new THREE.CylinderGeometry(6.6, 7.6, 1.4, 12), metal, 0, 0.7, 0);\n      add(new THREE.BoxGeometry(4.4, 17, 4.4), metal, 0, 9.5, 0);\n      add(new THREE.BoxGeometry(2.4, 8, 2.4), stone, 0, 21.5, 0);\n      add(new THREE.BoxGeometry(3.2, 0.3, 3.2), glow, 0, 25.6, 0);\n      for (let i = 0; i < 4; i++){\n        const a = i / 4 * Math.PI * 2 + Math.PI / 4;\n        add(new THREE.BoxGeometry(1.1, 9, 1.1), steel, Math.cos(a) * 5, 4.5, Math.sin(a) * 5, 0, a, 0);\n      }\n    }\n  }\n\n  /* lamps */\n  const poleGeo = new THREE.CylinderGeometry(0.09, 0.13, 6.4, 6);\n  for (let i = 0; i < 26; i++){\n    const a = (i / 26) * Math.PI * 2;\n    const rr = 20 + (i % 3) * 4;\n    const pole = new THREE.Mesh(poleGeo, metal);\n    pole.position.set(Math.cos(a) * rr, 3.2, Math.sin(a) * rr);\n    pole.castShadow = true;\n    surfaceRoot.add(pole);\n    const head = new THREE.Mesh(new THREE.SphereGeometry(0.26, 8, 6), warmGlow);\n    head.position.set(Math.cos(a) * rr, 6.5, Math.sin(a) * rr);\n    surfaceRoot.add(head);\n  }\n  /* distant terrain silhouette */\n  const hills = new THREE.Mesh(new THREE.CylinderGeometry(120, 134, 26, 64, 1, true), new THREE.MeshStandardMaterial({ color: new THREE.Color(d.body).multiplyScalar(0.5), metalness: 0.1, roughness: 1, side: THREE.DoubleSide }));\n  hills.position.y = 12;\n  surfaceRoot.add(hills);\n\n  /* lights */\n  if (surfaceLights) surface.remove(surfaceLights);\n  surfaceLights = new THREE.Group();\n  const sun = new THREE.DirectionalLight(new THREE.Color(d.sec).lerp(new THREE.Color('#e8eef4'), 0.55), 2.9);\n  sun.position.set(86, 108, 64);\n  sun.castShadow = true;\n  sun.shadow.mapSize.set(2048, 2048);\n  sun.shadow.camera.left = -90; sun.shadow.camera.right = 90; sun.shadow.camera.top = 90; sun.shadow.camera.bottom = -90;\n  sun.shadow.camera.near = 1; sun.shadow.camera.far = 320; sun.shadow.bias = -0.0008;\n  surfaceLights.add(sun);\n  const fill = new THREE.HemisphereLight(new THREE.Color(d.accent).lerp(new THREE.Color('#cfe0e6'), 0.5), new THREE.Color('#243038'), 1.15);\n  surfaceLights.add(fill);\n  const bounce = new THREE.AmbientLight(new THREE.Color(d.accent), 0.32);\n  surfaceLights.add(bounce);\n  const core = new THREE.PointLight(new THREE.Color(d.accent), 120, 80, 2);\n  core.position.set(0, 14, 0);\n  surfaceLights.add(core);\n  surface.add(surfaceLights);\n\n  surfaceCam = { dist: 74, height: 42, angle: 0.9, target: new THREE.Vector3(0, 8, 0) };\n}\n\n/* ---------- camera rigs ---------- */\nlet cam = { dist: 146, yaw: 0, pitch: 0, vy: 0, vp: 0 };\nlet surfaceCam = { dist: 74, height: 42, angle: 0.9, target: new THREE.Vector3(0, 8, 0) };\nlet pointer = { down: false, x: 0, y: 0, moved: 0, drag: false };\n\n/* ---------- UI wiring ---------- */\nconst strip = document.getElementById('strip');\nconst markersEl = document.getElementById('markers');\n\nconst stripButtons = D.map((d, i) => {\n  const b = document.createElement('button');\n  b.className = 'strip-btn';\n  b.style.setProperty('--c', d.accent);\n  b.innerHTML = `<u></u><em>${String(i + 1).padStart(2, '0')}</em><strong>${d.short}</strong>`;\n  b.onclick = () => select(i);\n  strip.appendChild(b);\n  return b;\n});\n\nconst markerEls = D.map((d, i) => {\n  const b = document.createElement('button');\n  b.className = 'mk';\n  b.style.setProperty('--accent', d.accent);\n  b.innerHTML = `<i style=\"background:${d.accent}\"></i><span>${d.short}</span>`;\n  b.onclick = (ev) => { ev.stopPropagation(); select(i); };\n  markersEl.appendChild(b);\n  return b;\n});\n\nfunction select(i){\n  state.index = i;\n  const d = D[i];\n  root.style.setProperty('--accent', d.accent);\n  stripButtons.forEach((b, k) => b.dataset.on = k === i ? '1' : '0');\n  markerEls.forEach((b, k) => b.dataset.on = k === i ? '1' : '0');\n  beaconMeshes.forEach((g, k) => { g.scale.setScalar(k === i ? 1.75 : 1); });\n  document.getElementById('cardIndex').textContent = 'DESTINATION / ' + String(i + 1).padStart(2, '0');\n  document.getElementById('cardNameText').textContent = d.name;\n  document.getElementById('cardPurpose').textContent = d.purpose;\n  document.getElementById('cardLandmark').textContent = d.landmark;\n  document.getElementById('cardCount').textContent = d.projects + ' PROJECTS';\n  document.getElementById('drawerTitle').textContent = 'PROJECTS / ' + d.name.toUpperCase();\n  renderDrawer(d);\n  if (state.mode === 'surface'){ buildSurface(d); updateSurfaceIdentity(d); }\n}\n\nfunction renderRecords(d){\n  return RECORDS.filter(r => r[1] === d.id);\n}\nfunction renderDrawer(d){\n  const list = document.getElementById('drawerList');\n  const rows = renderRecords(d);\n  list.innerHTML = rows.length ? rows.map(([name, cat, st, views, years]) => `\n    <button class=\"rec\">\n      <span class=\"dt\" style=\"background:${STATUS_COLOR[st]}\"></span>\n      <span class=\"nm\">${name}</span>\n      <span class=\"vw\">${st === 'live' ? 'Live' : STATUS_TEXT[st]}</span>\n      <span class=\"vw\">${views.toLocaleString()}</span>\n    </button>`).join('') : '<p class=\"px-[14px] py-[10px] text-[11px] text-[#7f939a]\">No records in this district.</p>';\n}\n\ndocument.getElementById('btnProjects').onclick = () => toggleDrawer(true);\ndocument.getElementById('drawerClose').onclick = () => toggleDrawer(false);\nfunction toggleDrawer(force){\n  state.drawer = force;\n  const el = document.getElementById('drawer');\n  el.style.opacity = force ? '1' : '0';\n  el.style.transform = force ? 'translateX(0)' : 'translateX(8px)';\n  el.style.pointerEvents = force ? 'auto' : 'none';\n}\n\ndocument.getElementById('btnDescend').onclick = () => descend();\ndocument.getElementById('lowFx').onchange = (e) => { state.lowFx = e.target.checked; };\n\nfunction setViewLabel(t){ document.getElementById('viewLabel').textContent = t; }\n\n/* ---------- descent ---------- */\nlet dive = 0;\nfunction descend(){\n  if (state.mode !== 'orbit' || state.diving) return;\n  const d = D[state.index];\n  state.diving = true;\n  veil.style.background = `radial-gradient(ellipse at 56% 48%, ${d.accent}22 0%, #040a10 68%)`;\n  veil.style.opacity = '1';\n  dive = 1;\n  setViewLabel('DESCENDING');\n  window.setTimeout(() => {\n    state.mode = 'surface';\n    buildSurface(d);\n    surfaceCam = { dist: 96, height: 62, angle: 0.9, target: new THREE.Vector3(0, 8, 0) };\n    veil.style.opacity = '0';\n    setViewLabel('SURFACE VIEW');\n    document.getElementById('descendLabel').textContent = 'Return to orbit';\n    document.getElementById('btnDescend').onclick = () => ascend();\n    document.getElementById('intro').style.display = 'none';\n    document.getElementById('surfaceId').style.display = 'block';\n    updateSurfaceIdentity(d);\n    dive = 0;\n    state.diving = false;\n  }, 560);\n}\nfunction ascend(){\n  if (state.mode !== 'surface' || state.diving) return;\n  state.diving = true;\n  veil.style.opacity = '1';\n  dive = 1;\n  window.setTimeout(() => {\n    state.mode = 'orbit';\n    veil.style.opacity = '0';\n    setViewLabel('ORBITAL VIEW');\n    document.getElementById('descendLabel').textContent = 'Descend into city';\n    document.getElementById('btnDescend').onclick = () => descend();\n    document.getElementById('intro').style.display = 'block';\n    document.getElementById('surfaceId').style.display = 'none';\n    dive = 0;\n    state.diving = false;\n  }, 520);\n}\nfunction updateSurfaceIdentity(d){\n  document.getElementById('sName').textContent = d.name;\n  document.getElementById('sCopy').textContent = d.purpose;\n  document.getElementById('sLandmark').textContent = d.landmark;\n  document.getElementById('sRecords').textContent = d.projects + ' buildings';\n}\n\n/* pointer interaction */\nconst el = renderer.domElement;\nel.style.touchAction = 'none';\nel.addEventListener('pointerdown', (e) => {\n  pointer.down = true; pointer.x = e.clientX; pointer.y = e.clientY; pointer.moved = 0; pointer.drag = false;\n  try { el.setPointerCapture(e.pointerId); } catch (err) { /* capture unsupported */ }\n});\nel.addEventListener('pointermove', (e) => {\n  if (!pointer.down) return;\n  const dx = e.clientX - pointer.x, dy = e.clientY - pointer.y;\n  pointer.x = e.clientX; pointer.y = e.clientY;\n  pointer.moved += Math.abs(dx) + Math.abs(dy);\n  if (pointer.moved > 6) pointer.drag = true;\n  if (state.mode === 'orbit'){\n    cam.vy = -dx * 0.00042; cam.vp = -dy * 0.00034;\n  } else {\n    surfaceCam.angle -= dx * 0.004;\n    surfaceCam.height = Math.max(14, Math.min(96, surfaceCam.height + dy * 0.18));\n  }\n});\nwindow.addEventListener('pointerup', () => { pointer.down = false; });\nel.addEventListener('wheel', (e) => {\n  e.preventDefault();\n  if (state.mode === 'orbit') cam.dist = Math.min(230, Math.max(52, cam.dist + e.deltaY * 0.06));\n  else surfaceCam.dist = Math.min(160, Math.max(34, surfaceCam.dist + e.deltaY * 0.06));\n}, { passive: false });\n\n/* planet click — only the planet itself starts a descent */\nconst raycaster = new THREE.Raycaster();\nel.addEventListener('click', (ev) => {\n  if (pointer.drag || state.diving) return;\n  if (state.mode !== 'orbit') return;\n  const rect = el.getBoundingClientRect();\n  const ndc = new THREE.Vector2(((ev.clientX - rect.left) / rect.width) * 2 - 1, -((ev.clientY - rect.top) / rect.height) * 2 + 1);\n  raycaster.setFromCamera(ndc, camera);\n  if (raycaster.intersectObject(planet, false).length) descend();\n});\n\n/* postprocessing (optional, tolerant of CDN addon load) */\nlet composer = null, bloomPass = null;\nasync function initPost(){\n  try {\n    const [{ EffectComposer }, { RenderPass }, { UnrealBloomPass }, { OutputPass }] = await Promise.all([\n      import('https://esm.sh/three@0.169.0/examples/jsm/postprocessing/EffectComposer.js'),\n      import('https://esm.sh/three@0.169.0/examples/jsm/postprocessing/RenderPass.js'),\n      import('https://esm.sh/three@0.169.0/examples/jsm/postprocessing/UnrealBloomPass.js'),\n      import('https://esm.sh/three@0.169.0/examples/jsm/postprocessing/OutputPass.js')\n    ]);\n    const c = new EffectComposer(renderer);\n    c.addPass(new RenderPass(scene, camera));\n    bloomPass = new UnrealBloomPass(new THREE.Vector2(1440, 840), 0.42, 0.85, 0.86);\n    c.addPass(bloomPass);\n    c.addPass(new OutputPass());\n    composer = c;\n  } catch (err) {\n    console.warn('bloom unavailable', err);\n  }\n}\n\n/* ---------- loop ---------- */\nlet last = performance.now(), t = 0, frames = 0, fpsTime = 0;\nconst clock = new THREE.Clock();\n\nfunction loop(){\n  requestAnimationFrame(loop);\n  const now = performance.now();\n  const dt = Math.min(0.05, (now - last) / 1000) || 0.016;\n  last = now; t += dt;\n  const d = D[state.index];\n\n  cam.yaw += cam.vy; cam.pitch += cam.vp;\n  cam.pitch = Math.max(-0.5, Math.min(0.5, cam.pitch));\n  cam.vy *= 0.92; cam.vp *= 0.9;\n\n  if (state.mode === 'orbit'){\n    world.rotation.y = cam.yaw + t * 0.018;\n    world.rotation.x = cam.pitch * 0.7;\n    planetMat.uniforms.uTime.value = t;\n    ringGroup.rotation.z = -0.22 + Math.sin(t * 0.06) * 0.02;\n    sat.position.set(Math.sin(t * 0.34) * 47.5, Math.sin(t * 0.7) * 1.4, Math.cos(t * 0.34) * 47.5);\n    sat.rotation.y = -t * 0.34;\n    beaconMeshes.forEach((g, i) => {\n      const s = i === state.index ? 1.75 + Math.sin(t * 2.2) * 0.09 : 1;\n      g.scale.setScalar(s);\n      g.lookAt(camera.position);\n      g.children[1].rotation.z = t * 0.5;\n    });\n    camera.position.set(0, 24 + Math.sin(t * 0.12) * 1.6, cam.dist * (1 - dive * 0.55));\n    camera.lookAt(world.position.x * 0.42, 2, 0);\n    updateMarkers();\n  } else {\n    surfaceCam.angle += dt * 0.045;\n    const target = Math.min(surfaceCam.dist, 74);\n    surfaceCam.dist += (target - surfaceCam.dist) * Math.min(1, dt * 1.6);\n    const h = surfaceCam.height;\n    camera.position.set(Math.cos(surfaceCam.angle) * surfaceCam.dist, h, Math.sin(surfaceCam.angle) * surfaceCam.dist);\n    camera.lookAt(surfaceCam.target);\n    beaconMeshes.forEach(g => g.visible = false);\n    markerEls.forEach(m => m.style.opacity = '0');\n    markerEls.forEach(m => m.style.pointerEvents = 'none');\n    world.visible = true;\n  }\n  if (state.mode === 'orbit'){\n    beaconMeshes.forEach(g => g.visible = true);\n    markerEls.forEach(m => m.style.pointerEvents = 'auto');\n  }\n\n  const activeScene = state.mode === 'orbit' ? scene : surface;\n  if (state.mode === 'surface') { surfaceRoot.position.y = 0; }\n\n  if (composer && !state.lowFx){\n    if (composer.passes[0].scene !== activeScene){ composer.passes[0].scene = activeScene; }\n    composer.render();\n  } else {\n    renderer.render(activeScene, camera);\n  }\n\n  frames++; fpsTime += dt;\n  if (fpsTime > 1){\n    document.getElementById('fps').textContent = Math.round(frames / fpsTime) + ' FPS';\n    frames = 0; fpsTime = 0;\n    resize();\n  }\n}\n\nconst projTarget = new THREE.Vector3();\nfunction updateMarkers(){\n  const rect = renderer.domElement.getBoundingClientRect();\n  const camDir = camera.position.clone().sub(world.position).normalize();\n  D.forEach((d, i) => {\n    const normalWorld = anchors[i].clone().applyEuler(world.rotation).normalize();\n    const worldPos = anchors[i].clone().multiplyScalar(R + 1.6).applyEuler(world.rotation).add(world.position);\n    const facing = normalWorld.dot(camDir);\n    projTarget.copy(worldPos).project(camera);\n    const x = (projTarget.x * 0.5 + 0.5) * rect.width;\n    const y = (-projTarget.y * 0.5 + 0.5) * rect.height;\n    const el = markerEls[i];\n    if (facing < 0.16 || projTarget.z > 1){ el.style.opacity = '0'; el.style.pointerEvents = 'none'; return; }\n    el.style.opacity = String(Math.min(1, (facing - 0.14) * 4.2));\n    el.style.pointerEvents = 'auto';\n    el.style.left = x + 'px';\n    el.style.top = y + 'px';\n  });\n}\n\n/* init */\nresize();\nselect(0);\nrenderDrawer(D[0]);\nbuildSurface(D[0]);\nstate.mode = 'orbit';\ninitPost().then(() => {});\nloop();\n\n// ResizeObserver keeps the buffer aligned with the iframe even without window events\nif (window.ResizeObserver) new ResizeObserver(resize).observe(stage);\n</script>",
